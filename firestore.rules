rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'photoURL', 'fullName', 'username', 'dateOfBirth', 'phone',
          'gender', 'isStudent', 'collegeName', 'major', 'currentYear', 'graduationYear',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 40
        && request.resource.data.dateOfBirth is string
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.gender is string
        && request.resource.data.isStudent is bool
        && request.resource.data.collegeName is string
        && request.resource.data.major is string
        && request.resource.data.currentYear is string
        && request.resource.data.graduationYear is string;
    }

    function validRegistration(userId) {
      return request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.status == 'registered';
    }

    function validContactMessage() {
      return request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 2
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 20
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || admin());
      allow list: if admin();
      allow create, update: if signedIn() && request.auth.uid == userId && validUserProfile(userId);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if admin();

      match /registrations/{userId} {
        allow get: if signedIn() && (request.auth.uid == userId || admin());
        allow list: if admin();
        allow create, update: if signedIn() && request.auth.uid == userId && validRegistration(userId);
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /startups/{startupId} {
      allow read: if true;
      allow write: if admin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if admin();
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow write: if admin();
    }

    match /contactMessages/{messageId} {
      allow create: if validContactMessage();
      allow read, update, delete: if admin();
    }
  }
}
